import java.util.Scanner;

abstract class ThreeDObject {
    private double dim1;
    private double dim2;
    private double dim3;

    public ThreeDObject() {
        dim1 = dim2 = dim3 = 0;
    }

    public ThreeDObject(double d1, double d2, double d3) {
        this.dim1 = d1;
        this.dim2 = d2;
        this.dim3 = d3;
    }

    public double getDim1() { return dim1; }
    public double getDim2() { return dim2; }
    public double getDim3() { return dim3; }

    public void setDim1(double d1) { this.dim1 = d1; }
    public void setDim2(double d2) { this.dim2 = d2; }
    public void setDim3(double d3) { this.dim3 = d3; }

    public abstract double wholeSurfaceArea();
    public abstract double volume();
}

class Box extends ThreeDObject {
    public Box() { super(); }
    public Box(double l, double b, double h) { super(l, b, h); }

    public double wholeSurfaceArea() {
        double l = getDim1();
        double b = getDim2();
        double h = getDim3();
        return 2 * (l*b + b*h + h*l);
    }

    public double volume() {
        return getDim1() * getDim2() * getDim3();
    }
}

class Cube extends ThreeDObject {
    public Cube() { super(); }
    public Cube(double side) { super(side, side, side); }

    public double wholeSurfaceArea() {
        double s = getDim1();
        return 6 * s * s;
    }

    public double volume() {
        double s = getDim1();
        return s * s * s;
    }
}

class Cylinder extends ThreeDObject {
    public Cylinder() { super(); }
    public Cylinder(double r, double h) { super(r, h, 0); }

    public double wholeSurfaceArea() {
        double r = getDim1();
        double h = getDim2();
        return 2 * Math.PI * r * (r + h);
    }

    public double volume() {
        double r = getDim1();
        double h = getDim2();
        return Math.PI * r * r * h;
    }
}

class Cone extends ThreeDObject {
    public Cone() { super(); }
    public Cone(double r, double h) { super(r, h, 0); }

    public double wholeSurfaceArea() {
        double r = getDim1();
        double h = getDim2();
        double l = Math.sqrt(r*r + h*h);
        return Math.PI * r * (r + l);
    }

    public double volume() {
        double r = getDim1();
        double h = getDim2();
        return (1.0/3) * Math.PI * r * r * h;
    }
}

public class Driver {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int choice;

        do {
            System.out.println("\n1. Box\n2. Cube\n3. Cylinder\n4. Cone\n5. Exit");
            System.out.print("Enter choice: ");
            choice = sc.nextInt();

            if (choice == 1) {
                System.out.print("Enter length breadth height: ");
                double l = sc.nextDouble();
                double b = sc.nextDouble();
                double h = sc.nextDouble();
                ThreeDObject obj = new Box(l, b, h);
                print(obj);
            } else if (choice == 2) {
                System.out.print("Enter side: ");
                double s = sc.nextDouble();
                ThreeDObject obj = new Cube(s);
                print(obj);
            } else if (choice == 3) {
                System.out.print("Enter radius height: ");
                double r = sc.nextDouble();
                double h = sc.nextDouble();
                ThreeDObject obj = new Cylinder(r, h);
                print(obj);
            } else if (choice == 4) {
                System.out.print("Enter radius height: ");
                double r = sc.nextDouble();
                double h = sc.nextDouble();
                ThreeDObject obj = new Cone(r, h);
                print(obj);
            }
        } while (choice != 5);

        sc.close();
    }

    public static void print(ThreeDObject obj) {
        System.out.println("Volume = " + obj.volume());
        System.out.println("Surface Area = " + obj.wholeSurfaceArea());
    }
}

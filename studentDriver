import java.util.Scanner;

interface Department {
    void getDeptData(Scanner sc);
    void printDeptData();
}

class Hostel {
    private String hostelName;
    private String hostelLocation;
    private int noOfRooms;

    public Hostel() {
        hostelName = "";
        hostelLocation = "";
        noOfRooms = 0;
    }

    public Hostel(String name, String location, int rooms) {
        hostelName = name;
        hostelLocation = location;
        noOfRooms = rooms;
    }

    public void getHostelData(Scanner sc) {
        System.out.print("Enter hostel name: ");
        hostelName = sc.nextLine();
        System.out.print("Enter hostel location: ");
        hostelLocation = sc.nextLine();
        System.out.print("Enter number of rooms: ");
        noOfRooms = sc.nextInt();
        sc.nextLine();
    }

    public void printHostelData() {
        System.out.println("Hostel Name: " + hostelName);
        System.out.println("Hostel Location: " + hostelLocation);
        System.out.println("No of Rooms: " + noOfRooms);
    }
}

class Student extends Hostel implements Department {
    private String studentName;
    private String regNo;
    private String electiveSubject;
    private double avgMarks;
    private String depName;
    private String depHead;

    public Student() {
        super();
        studentName = "";
        regNo = "";
        electiveSubject = "";
        avgMarks = 0;
        depName = "";
        depHead = "";
    }

    public void getData(Scanner sc) {
        System.out.print("Enter student name: ");
        studentName = sc.nextLine();
        System.out.print("Enter registration number: ");
        regNo = sc.nextLine();
        System.out.print("Enter elective subject: ");
        electiveSubject = sc.nextLine();
        System.out.print("Enter average marks: ");
        avgMarks = sc.nextDouble();
        sc.nextLine();
        getHostelData(sc);
        getDeptData(sc);
    }

    public void printData() {
        System.out.println("Name: " + studentName);
        System.out.println("Reg No: " + regNo);
        System.out.println("Elective Subject: " + electiveSubject);
        System.out.println("Average Marks: " + avgMarks);
        printHostelData();
        printDeptData();
    }

    public void getDeptData(Scanner sc) {
        System.out.print("Enter department name: ");
        depName = sc.nextLine();
        System.out.print("Enter department head: ");
        depHead = sc.nextLine();
    }

    public void printDeptData() {
        System.out.println("Department Name: " + depName);
        System.out.println("Department Head: " + depHead);
    }
}

public class Driver {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Student s = new Student();
        s.getData(sc);
        s.printData();
        sc.close();
    }
}
